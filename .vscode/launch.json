{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Jovial Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/out/**/*.js"],
      "preLaunchTask": "build: debug"
    }
  ]
}
