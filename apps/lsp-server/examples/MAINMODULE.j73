START
!COMPOOL ('MAINCOMP');

REF PROC HELPER RENT (NUM);
BEGIN
    ITEM NUM U 6; 
END

DEFINE TEST "AA"; 

DEFINE TEST1 "5"; 

DEF PROC MAIN RENT;
BEGIN
    ITEM NUMBER U 6 = 1;
    ITEM NUMBER1 U 6 = 2;

    ITEM AA U TEST1;
    "WRONG TYPE SENT"
    HELPER(THAT'ONE'WITH'THE'ODD'NAME);

    HELPER(NUMBER, NUMBER1); %THATS THE SPIRIT %
    TEST = 2;
    HELP3();
    SUM(: TEST , AA);
    
    JUST'A'BIT'STREAM = 4; % IMPORTED, WRONG TYPE%
    JUST'A'BIT'STREAM = NICE'BIT'WID'SIZE;
END

PROC SUM( MICHAEL, THIRD) U 5;
BEGIN 
ITEM FIRST S 4;
ITEM SEC U 5;
    RETURN FIRST + SEC;
END
TERM