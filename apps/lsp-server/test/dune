(executable
 (name lsp_responsiveness_test)
 (libraries jovial_lsp_lib yojson unix threads))

(rule
 (alias runtest)
 (action
  (setenv JOVIAL_TEST_INDEXING_HARD_TIMEOUT_S "180"
   (setenv JOVIAL_TEST_RESP_INDEX_FILES "900"
    (setenv JOVIAL_TEST_RESP_TIMEOUT_S "10"
     (run %{exe:lsp_responsiveness_test.exe} %{exe:../bin/Main.exe}))))))

