{
  "name": "jovial-monorepo",
  "private": true,
  "scripts": {
    "build:server:win-x64": "node ./tools/scripts/build-server.js --target win32-x64",
    "build:server:win-arm64": "node ./tools/scripts/build-server.js --target win32-arm64",
    "test:server": "npm run test:server:smoke && npm run test:server:stability",
    "test:server:smoke": "opam exec -- dune build --root ./apps/lsp-server @runtest-smoke --force --verbose",
    "test:server:stability": "opam exec -- dune build --root ./apps/lsp-server @runtest-stability --force --verbose",
    "test:server:perf": "opam exec -- dune build --root ./apps/lsp-server @runtest-perf --force --verbose",
    "format:check:server": "node ./tools/scripts/check-ocamlformat.mjs",
    "build:extension": "npm --prefix ./apps/vscode-extension run compile",
    "lint:extension": "npm --prefix ./apps/vscode-extension run lint",
    "format:check:extension": "npm --prefix ./apps/vscode-extension run format:check",
    "check:extension": "npm --prefix ./apps/vscode-extension run check",
    "test:extension": "npm --prefix ./apps/vscode-extension run test",
    "check": "npm run format:check:server && npm run lint:extension && npm run format:check:extension && npm run check:extension && npm run test:extension",
    "package:vsix:dev": "npm --prefix ./apps/vscode-extension run package:vsix:dev",
    "package:vsix:release": "npm --prefix ./apps/vscode-extension run package:vsix:release",
    "clean": "powershell -ExecutionPolicy Bypass -File ./tools/scripts/clean-generated.ps1"
  }
}
